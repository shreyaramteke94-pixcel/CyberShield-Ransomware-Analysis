# ==========================
# CyberShield Configuration Example
# ==========================

APP_NAME=CyberShield
APP_VERSION=1.0.0
DEBUG=True

HOST=127.0.0.1
PORT=8000

# Replace with a secure random secret key in production
SECRET_KEY=change-me-to-a-secure-random-secret-key-at-least-32-chars

DATABASE_URL=sqlite:///./cybershield.db

UPLOAD_DIR=uploads
REPORT_DIR=reports

MAX_FILE_SIZE=52428800
ALLOWED_EXTENSIONS=exe,dll,zip,7z,pdf,docx,txt
